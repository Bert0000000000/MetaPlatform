import { defineConfig } from 'vite';
import react from '@vitejs/plugin-react';
import path from 'path';

export default defineConfig({
  plugins: [react()],
  resolve: {
    alias: {
      '@': path.resolve(import.meta.dirname, './src'),
      '@mate/shared$': path.resolve(import.meta.dirname, '../../packages/shared/src/index.ts'),
      '@ant-design/icons$': path.resolve(import.meta.dirname, '../../packages/shared/src/icons/index.tsx'),
    },
  },
  server: {
    port: 9240,
    // Path-prefix router that dispatches /v1/copilot/* (the SuperAI frontend legacy
    // APP-COPILOT surface) to the correct local TECH-* backend:
    //   /v1/copilot/auth/*         -> TECH-IAM   :8101  (/api/v1/iam/*)
    //   /v1/copilot/superai/*     -> TECH-AGENT :8511  (/api/v1/agent/superai/*)
    //   /v1/copilot/runs/*        -> TECH-AGENT :8511  (/api/v1/agent/runs/*)
    //   /v1/copilot/conversations -> TECH-AGENT :8511  (/api/v1/agent/conversations/*)
    //   /v1/copilot/chat/*        -> TECH-AGENT :8511  (/api/v1/agent/superai/*)
    //   /v1/copilot/ontology/*    -> TECH-ONT   :8201  (/api/v1/ont/*)
    //   /v1/copilot/knowledge-bases + /v1/copilot/search -> TECH-RAG :8901 (/api/v1/rag/* + /api/v1/kb/*)
    proxy: {
      // /v1/copilot/auth/*  -> TECH-IAM 8101, rewrite /v1/copilot/auth -> /api/v1/iam/auth
      '^/v1/copilot/auth/': {
        target: 'http://localhost:8101',
        changeOrigin: true,
        rewrite: (p) => p.replace(/^\/v1\/copilot\/auth/, '/api/v1/iam/auth'),
      },
      // /v1/copilot/ontology/* -> TECH-ONT 8201, /v1/copilot/ontology -> /api/v1/ont
      '^/v1/copilot/ontology/': {
        target: 'http://localhost:8201',
        changeOrigin: true,
        rewrite: (p) => p.replace(/^\/v1\/copilot\/ontology/, '/api/v1/ont'),
      },
      // /v1/copilot/{knowledge-bases,search,rag,documents,citations,graph,context,kb} -> TECH-RAG 8901
      // RAG exposes /api/v1/rag/* + /api/v1/kb/* + /api/v1/search, so we rewrite the /v1/copilot/ prefix
      // to /api/v1/ and let the trailing segment decide the controller (rag|kb|search|...).
      // (Vite proxy keys accept path strings OR RegExp; the path string form is fine for prefixes.)
      // /v1/copilot/knowledge-bases -> /api/v1/rag/knowledge-bases
      '^/v1/copilot/knowledge-bases': {
        target: 'http://localhost:8901',
        changeOrigin: true,
        rewrite: (p) => '/api/v1/rag/knowledge-bases',
      },
      // /v1/copilot/search -> /api/v1/rag/search
      '^/v1/copilot/search': {
        target: 'http://localhost:8901',
        changeOrigin: true,
        rewrite: (p) => '/api/v1/rag/search',
      },
      '^/v1/copilot/': {
        target: 'http://localhost:8901',
        changeOrigin: true,
        rewrite: (p) => p.replace(/^\/v1\/copilot\//, '/api/v1/'),
      },
      // fallback: any /v1/copilot/* not matched above -> TECH-AGENT 8511 (closest semantic match),
      // with rewrite /v1/copilot/ -> /api/v1/agent/
      '/v1/copilot': {
        target: 'http://localhost:8511',
        changeOrigin: true,
        rewrite: (p) => p.replace(/^\/v1\/copilot\//, '/api/v1/agent/'),
      },
    },
  },
  build: {
    target: 'es2020',
    minify: 'esbuild',
    sourcemap: false,
  },
});


