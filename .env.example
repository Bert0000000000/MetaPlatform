# =============================================================================
# MetaPlatform 杩愯鏃剁幆澧冨彉閲?(cp .env.example .env 鐒跺悗濉€?
# =============================================================================

# ---- 閫氱敤 ----
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# ---- PostgreSQL ----
POSTGRES_USER=meta
POSTGRES_PASSWORD=meta
POSTGRES_DB=metaplatform
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=meta
MINIO_ROOT_PASSWORD=metasecretkey123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Neo4j ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=mate-pass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---- Kafka / RabbitMQ / Nacos ----
KAFKA_PORT=9092
RABBITMQ_USER=meta
RABBITMQ_PASSWORD=meta-secret
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
NACOS_USER=nacos
NACOS_PASSWORD=nacos
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848

# ---- Milvus ----
MILVUS_PORT=19530

# ---- LLM Providers (蹇呭～鑷冲皯涓€涓? ----
# 鑷冲皯闇€瑕?OPENAI_API_KEY 鎵嶈兘璺戦€?RAG / Agent / LightRAG
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ARK_API_KEY=
DASHSCOPE_API_KEY=

# ---- LLMGW ----
LLM_PROVIDER=openai
MATE_LLMGW_PORT=8008

# ---- RAG ----
RAG_MODE=full                # memory | hybrid | graph | full
EMBEDDER_PROVIDER=local      # local | openai | hash
MATE_RAG_PORT=8001
LIGHTRAG_API_KEY=
LIGHTRAG_LLM_MODEL=gpt-4o-mini
LIGHTRAG_EMBED_MODEL=text-embedding-3-small
RAGFLOW_API_KEY=

# ---- AI 澶栭儴鏈嶅姟 (profile: ai 鏃朵娇鐢? ----
RAGFLOW_PORT=9380
LIGHTRAG_PORT=9621
MYSQL_USER=ragflow
MYSQL_PASSWORD=ragflow-pass

# ---- DeerFlow Deep Research (profile: research / ai) ----
DEERFLOW_URL=http://deerflow-engine:8001
DEERFLOW_API_KEY=
TAVILY_API_KEY=
DEERFLOW_PORT=8001

# ---- Python 鏈嶅姟绔彛 ----
MATE_AGENT_PORT=8002
MATE_APP_KB_PORT=8003
MATE_ONT_PORT=8007
MATE_MSG_PORT=8082
MATE_MCP_PORT=8081
MATE_OBS_PORT=8083
MCP_TRANSPORT=http

# ---- Java 寮曟搸 (profile: java) ----
FLOWABLE_PORT=8181
KIE_PORT=8280

# ---- 鍙娴嬫€?(profile: monitoring) ----
LOKI_PORT=3100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ---- 杈圭綉鍏?(profile: edge) ----
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# ---- API Gateway ----
API_GW_PORT=8100
API_GW_RATE_LIMIT=600
API_GW_TIMEOUT=60

# ---- Auth Service ----
AUTH_SVC_PORT=8101
KEYCLOAK_REALM=metaplatform
KEYCLOAK_CLIENT_ID=metaplatform-backend
JWKS_REFRESH_SEC=300
