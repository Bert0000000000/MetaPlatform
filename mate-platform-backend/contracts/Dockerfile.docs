FROM node:22-alpine AS build
WORKDIR /workspace/contracts
COPY mate-platform-backend/contracts/package.json mate-platform-backend/contracts/package-lock.json ./
RUN npm ci
COPY mate-platform-backend/contracts ./
RUN npm run check

FROM nginx:1.27-alpine
COPY docs/swagger /usr/share/nginx/html/docs/swagger
COPY --from=build /workspace/contracts/openapi/generated/bundled.yaml /usr/share/nginx/html/mate-platform-backend/contracts/openapi/generated/bundled.yaml
EXPOSE 80
