`tests/architecture/test_dependency_directions.py`?

```python
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


def test_domain_modules_do_not_import_infrastructure() -> None:
    domain_dirs = [
        ROOT / "packages" / "mate-tech-rag" / "src" / "mate_tech_rag" / "domain",
    ]
    forbidden = (
        "sqlalchemy", "redis", "aiokafka", "neo4j", "pymilvus", "minio", "httpx", "fastapi",
    )
    for directory in domain_dirs:
        if not directory.exists():
            continue
        for path in directory.rglob("*.py"):
            text = path.read_text(encoding="utf-8")
            assert not any(token in text for token in forbidden), path
```

