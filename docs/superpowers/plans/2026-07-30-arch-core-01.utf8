- [ ] **Step 6: ?? architecture_check CLI**

`scripts/architecture_check.py`?

```python
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LINTER = ROOT / "tests" / "architecture" / "import-linter.ini"


def main() -> int:
    exe = shutil.which("lint-imports")
    if exe is None:
        proc = subprocess.run(
            [sys.executable, "-m", "lint_imports", "--config", str(LINTER)],
            cwd=ROOT, check=False,
        )
    else:
        proc = subprocess.run(
            [exe, "--config", str(LINTER)], cwd=ROOT, check=False,
        )
    return proc.returncode


if __name__ == "__main__":
    raise SystemExit(main())
```

